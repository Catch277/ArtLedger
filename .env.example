# Copy to .env.local and fill in. The values here are deliberately empty.

# Pinata JWT. Server-side only - never prefix it with NEXT_PUBLIC_, because
# anything public is inlined into the client bundle.
# app.pinata.cloud -> API Keys -> New Key (pinFileToIPFS + pinJSONToIPFS) -> copy the JWT, not the API key.
PINATA_JWT=

# Public Sepolia RPC endpoint (Alchemy, Infura, Ankr, or any public node).
# Public example: https://eth-sepolia.api.onfinality.io/public
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Deployed TacPhamNFT ERC-721 contract address on Sepolia (0x...).
# Leave empty and the app shows a setup notice instead of failing.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Optional: block the contract was deployed at. Bounds the eth_getLogs scan used by
# /api/history and the verification timeline. Leave empty to scan from genesis.
NEXT_PUBLIC_DEPLOY_BLOCK=

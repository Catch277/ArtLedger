# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template has to ship: it documents the three variables and holds no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# commercially licensed typefaces are not published with the repo (app/fonts/index.ts uses next/font/google)
*.otf
next-env.d.ts
